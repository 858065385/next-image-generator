# ==============================================
# AI Image Video API 环境变量配置示例
# ==============================================
# 复制此文件到 .env.local 并填入您的实际配置值

# ==============================================
# 基础配置
# ==============================================

# 域名配置（生产环境URL）
NEXT_PUBLIC_DOMAIN="https://yourdomain.com/"

# 网站基础 URI
WEB_BASE_URI="https://yourdomain.com/"
# 本地开发使用: http://localhost:3000

# ==============================================
# 数据库配置 (PostgreSQL)
# ==============================================

# 数据库连接字符串
POSTGRES_URL="postgresql://username:password@host:port/database"
# Supabase 示例: "postgresql://postgres.projectid:password@aws-0-region.pooler.supabase.com:6543/postgres"

# ==============================================
# 身份认证配置 (NextAuth.js)
# ==============================================

# NextAuth 密钥（生成命令: openssl rand -base64 32）
NEXTAUTH_SECRET="your_nextauth_secret_32_chars"

# NextAuth URL（通常与 WEB_BASE_URI 相同）
NEXTAUTH_URL="https://yourdomain.com/"
# 本地开发使用: http://localhost:3000

# Google OAuth 配置
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://yourdomain.com/api/auth/callback/google"
# 本地开发使用: http://localhost:3000/api/auth/callback/google

# ==============================================
# 支付配置 (Creem)
# ==============================================

# Creem API 配置
CREEM_API_KEY="your_creem_api_key"
CREEM_WEBHOOK_SECRET="your_creem_webhook_secret"
CREEM_API_BASE_URL="https://api.creem.io"
# 测试环境使用: https://test-api.creem.io

# Creem 产品 ID（在 Creem 后台创建产品后获取）
CREEM_PRODUCT_MONTHLY_ID="prod_monthly_xxx"
CREEM_PRODUCT_YEARLY_ID="prod_yearly_xxx"

# 支付成功后跳转的URL（可选，有默认值）
# 默认值: /admin/payment-result?success=true
CREEM_SUCCESS_URL="/admin/payment-result?success=true"

# ==============================================
# AI 服务配置 (Replicate)
# ==============================================

# Replicate API Token
REPLICATE_API_TOKEN="r8_your_replicate_api_token"

# Replicate Webhook Secret（可选，用于接收生成结果）
REPLICATE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# ==============================================
# 文件存储配置 (Cloudflare R2)
# ==============================================

# R2 访问凭据
R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# R2 存储桶配置
R2_BUCKET_NAME="your_bucket_name"
R2_ENDPOINT="https://your_domain.r2.cloudflarestorage.com"

# R2 Token（可选，某些操作可能需要）
R2_TOKEN="your_r2_token"

# ==============================================
# 兼容性配置（保留以防某些代码仍在使用）
# ==============================================

# 注意：已迁移到 Creem，以下 Stripe 配置可以留空或删除
STRIPE_PUBLIC_KEY=""
STRIPE_PRIVATE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ==============================================
# 配置说明
# ==============================================

# 1. 数据库初始化：
#    psql -U username -d database -f src/backend/sql/init.sql
#    psql -U username -d database -f src/backend/sql/creem_migration.sql

# 2. Google OAuth 设置：
#    - 在 Google Cloud Console 创建 OAuth 2.0 客户端
#    - 设置授权重定向 URI: https://yourdomain.com/api/auth/callback/google

# 3. Creem 配置：
#    - 注册 Creem 账户并创建产品
#    - 配置 Webhook URL: https://yourdomain.com/api/webhook/creem
#    - 监听事件: subscription.paid, subscription.canceled, subscription.expired

# 4. Replicate 配置：
#    - 注册 Replicate 账户获取 API Token
#    - 配置 Webhook URL: https://yourdomain.com/api/webhook/replicate

# 5. Cloudflare R2 配置：
#    - 创建 R2 存储桶
#    - 生成 API Token 和访问密钥
#    - 配置 CORS 策略允许前端上传

# ==============================================
# 本地开发快速配置
# ==============================================

# 最小化本地开发配置（仅需要以下几项即可启动）：
# POSTGRES_URL=你的数据库连接
# NEXTAUTH_SECRET=随机32字符字符串  
# GOOGLE_CLIENT_ID=你的Google客户端ID
# GOOGLE_CLIENT_SECRET=你的Google客户端密钥
# REPLICATE_API_TOKEN=你的Replicate令牌